# If deployed via Vercel's Postgres/Neon storage integration, these two are
# created automatically when you connect a database to the project — you
# don't need to set them by hand there. For local dev or a self-hosted
# Postgres, set both to the same connection string.
POSTGRES_PRISMA_URL=postgresql://user:password@host:5432/dbname
POSTGRES_URL_NON_POOLING=postgresql://user:password@host:5432/dbname

JWT_SECRET=change-me-in-production
# openssl rand -base64 32
SECRET_ENCRYPTION_KEY=0000000000000000000000000000000000000000

# Leave GRAPH8_API_KEY unset to run in Demo Mode with seeded fictional deal data.
GRAPH8_API_KEY=
GRAPH8_BASE_URL=https://be.graph8.com/api/v1
GRAPH8_WEBHOOK_SECRET=

# Leave unset to fall back to the deterministic demo extractor (no LLM calls, works offline).
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
