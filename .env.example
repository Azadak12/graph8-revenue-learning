# Copy to .env and fill in as needed. Docker Compose overrides DATABASE_URL/REDIS_URL
# to point at its own postgres/redis services; these defaults are for local/non-Docker runs.

ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://g8:g8@localhost:5432/revenue_learning
REDIS_URL=redis://localhost:6379/0

JWT_SECRET=change-me-in-production
# openssl rand -base64 32
SECRET_ENCRYPTION_KEY=0000000000000000000000000000000000000000

# Leave GRAPH8_API_KEY unset to run in Demo Mode with seeded fictional deal data.
# Set it (and rotate the webhook secret) to switch to Live Mode against a real Graph8 org.
GRAPH8_API_KEY=
GRAPH8_BASE_URL=https://be.graph8.com/api/v1
GRAPH8_WEBHOOK_SECRET=

# Leave unset to fall back to the deterministic demo extractor (no LLM calls, works offline).
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
